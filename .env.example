# Summa Environment Variables
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.

# REQUIRED: JWT signing secret (256+ bits recommended)
# Generate with: openssl rand -hex 32
# MUST be at least 32 characters; shorter secrets will cause startup failure.
# SUMMA_JWT_SECRET=your-secret-here-at-least-32-chars

# Optional: SQLite database path (default: ~/.summa/summa.db locally; /data/db/summa.db in Docker)
# Note: ~ is not expanded in containers — use absolute paths or $HOME
# SUMMA_DB_PATH=~/.summa/summa.db

# Optional: DNA git repository path (default: ~/.summa/dna locally; /data/dna in Docker)
# Note: ~ is not expanded in containers — use absolute paths or $HOME
# SUMMA_DNA_REPO=~/.summa/dna

# Optional: Organization spend ceiling in USD (default: 1000000)
# SUMMA_SPEND_CEILING=1000000

# --- Build-time variables (baked into console bundle at build time) ---
# Optional: Console mode label (default: 'single-process'; 'multi-node' enables the multi-node badge)
# VITE_SUMMA_MODE=single-process

# Optional: API base URL baked into the console bundle at build time (default: '/api' via nginx proxy)
# VITE_API_URL=/api

# Optional: Spring profile (default: empty = uses application.yml; set to 'prod' for production overrides)
# SPRING_PROFILES_ACTIVE=prod

# Optional: extra CORS origins, comma-separated (default: localhost and 127.0.0.1 only)
# SUMMA_CORS_ORIGINS=https://app.example.com

# Optional: Git branch for DNA repo (default: main)
# SUMMA_GIT_BRANCH=main

# Optional: Enable local email+password auth (default: true; set false for OIDC-only)
# SUMMA_LOCAL_AUTH_ENABLED=true

# --- Operational mode ---
# Optional: Single-process or multi-node mode (default: single-process)
# SUMMA_MODE=single-process

# --- JWT ---
# Optional: JWT token expiration in milliseconds (default: 86400000 = 24 hours)
# SUMMA_JWT_EXPIRATION=86400000

# --- Node affinity ---
# Optional: Lease interval in seconds (default: 30)
# SUMMA_NODE_LEASE_INTERVAL=30
# Optional: Heartbeat timeout in seconds (default: 90)
# SUMMA_NODE_HEARTBEAT_TIMEOUT=90
# Optional: Affinity starvation threshold in hours (default: 24)
# SUMMA_NODE_AFFINITY_STARVATION=24

# --- Spawn limits ---
# Optional: Ephemeral token TTL in hours (default: 24)
# SUMMA_SPAWN_EPH_TOKEN_TTL=24
# Optional: Max concurrent spawns per spawner (default: 3)
# SUMMA_SPAWN_MAX_CONCURRENT=3
# Optional: Org-wide max active agents (default: 100)
# SUMMA_SPAWN_MAX_AGENTS=100
# Optional: Spawn depth cap (default: 2)
# SUMMA_SPAWN_DEPTH_CAP=2
# Optional: Budget window in days (default: 30)
# SUMMA_SPAWN_BUDGET_WINDOW=30

# --- Ask SLA deadlines (hours) ---
# Optional: Critical ask deadline (default: 1)
# SUMMA_ASKS_CRITICAL_DEADLINE=1
# Optional: Standard ask deadline (default: 24)
# SUMMA_ASKS_STANDARD_DEADLINE=24
# Optional: Bulk ask deadline (default: 24)
# SUMMA_ASKS_BULK_DEADLINE=24
# Optional: Storm collapse window in hours (default: 1)
# SUMMA_ASKS_STORM_COLLAPSE=1
# Optional: Rate limit per source per hour (default: 60)
# SUMMA_ASKS_RATE_LIMIT=60

# --- DNA review ---
# Optional: Default review SLA in days (default: 7)
# SUMMA_DNA_REVIEW_SLA=7

# --- Spend thresholds ---
# Optional: Critical floor percentage of ceiling (default: 5)
# SUMMA_CRITICAL_FLOOR_PERCENT=5

