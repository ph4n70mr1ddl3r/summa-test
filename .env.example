# Summa Environment Variables
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.

# REQUIRED: JWT signing secret (256+ bits recommended)
# Generate with: openssl rand -hex 32
SUMMA_JWT_SECRET=

# Optional: SQLite database path (default: ~/.summa/summa.db)
# SUMMA_DB_PATH=~/.summa/summa.db

# Optional: DNA git repository path (default: ~/.summa/dna)
# SUMMA_DNA_REPO=~/.summa/dna

# Optional: Organization spend ceiling in USD (default: 1000000)
# SUMMA_SPEND_CEILING=1000000

# Optional: OIDC/Keycloak configuration (for production human auth)
# SUMMA_OIDC_ISSUER=https://keycloak.example.com/realms/summa
# SUMMA_OIDC_CLIENT_ID=summa
# SUMMA_OIDC_CLIENT_SECRET=

# Optional: Console mode label (default: 'single-process')
# VITE_SUMMA_MODE=single-process
