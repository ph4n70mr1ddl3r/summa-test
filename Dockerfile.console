FROM node:22-alpine AS builder

WORKDIR /app/console

COPY console/package*.json ./
RUN npm ci

COPY console/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/console/dist /usr/share/nginx/html
COPY console/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
