FROM node:22-alpine AS builder

WORKDIR /app/console

# Vite env vars are baked into the bundle at build time.
ARG VITE_API_URL=/api
ARG VITE_SUMMA_MODE=single-process

COPY console/package*.json ./
RUN npm ci

COPY console/ .
RUN npm run build

FROM nginx:alpine
RUN addgroup -g 1000 -S nginx && adduser -u 1000 -S nginx -G nginx
COPY --from=builder /app/console/dist /usr/share/nginx/html
COPY console/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=10s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
