root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
indent_size = 2

[*.yml, *.yaml]
indent_size = 2

[*.json, *.jsonc]
indent_size = 2

[*.sh]
indent_size = 4

[*.java]
indent_size = 4
charset = utf-8

[*.ts, *.tsx]
indent_size = 2
charset = utf-8

[*.py]
indent_size = 4
charset = utf-8
